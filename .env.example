# Copy this file to .env beside the executables. Restart after editing.
# Existing process environment variables take precedence.
TYTAN_API_BASE_URL=https://tytan.poznan.pl/SQLupdate/
TYTAN_API_USERNAME=TytanSQL
# Password is optional here. Enter it in the desktop or set it in the terminal.
# Uncomment only if you accept storing the password in plain text:
# TYTAN_API_PASSWORD=your-server-password
